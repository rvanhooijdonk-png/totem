#!/usr/bin/env bash
# pre-commit hook — gitleaks + blokkeer gevaarlijke bestandsnamen
# Gedeeld door alle repos; niet handmatig aanpassen.
# Bypassen alleen via: git commit --no-verify -m "no-verify: <reden>"
set -euo pipefail

GITLEAKS="$HOME/.local/bin/gitleaks"
GITLEAKS_CONFIG="$HOME/.config/gitleaks/gitleaks.toml"

# ── 1. Blokkeer gevaarlijke bestandsnamen ──────────────────────────────────────
STAGED=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

while IFS= read -r PAD; do
    [ -z "$PAD" ] && continue
    NAAM=$(basename "$PAD" | tr '[:upper:]' '[:lower:]')

    # .env exact of als extensie (.env, .env.local, .env.production, ...)
    if echo "$NAAM" | grep -qiE '(^\.env$|^\.env\.|\.env$)'; then
        echo "❌ GEBLOKKEERD: bestandsnaam bevat .env — $PAD"
        echo "   Zet gevoelige waarden nooit in Git. Gebruik env-var verwijzingen."
        exit 1
    fi

    # token, secret, wachtwoord in bestandsnaam
    if echo "$NAAM" | grep -qiE '(token|secret|wachtwoord)'; then
        echo "❌ GEBLOKKEERD: bestandsnaam bevat gevoelig sleutelwoord — $PAD"
        echo "   Hernoem het bestand; gevoelige namen worden geweigerd ongeacht inhoud."
        exit 1
    fi
done <<< "$STAGED"

# ── 2. Gitleaks op staged changes ──────────────────────────────────────────────
if [ ! -x "$GITLEAKS" ]; then
    echo "⚠️  gitleaks niet gevonden op $GITLEAKS — installeer via:"
    echo "    curl -sSfL https://github.com/gitleaks/gitleaks/releases/latest -o /tmp/gl.tar.gz"
    echo "    tar -xzf /tmp/gl.tar.gz -C ~/.local/bin gitleaks"
    exit 0
fi

if ! "$GITLEAKS" protect --staged -c "$GITLEAKS_CONFIG" --no-banner 2>&1; then
    echo ""
    echo "❌ gitleaks detecteerde een mogelijke secret in de staged files."
    echo "   Verwijder de waarde of voeg een gitleaks:allow-comment toe in de regel."
    echo "   Skippen alleen met expliciete reden: git commit --no-verify -m 'no-verify: <reden>'"
    exit 1
fi

# ── 3. Per-repo test-gate (opt-in) ─────────────────────────────────────────────
# Draait als de repo een uitvoerbaar .githooks/pre-commit-tests.sh heeft. Rood = blokkeren.
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")
if [ -x "$REPO_ROOT/.githooks/pre-commit-tests.sh" ]; then
    if ! "$REPO_ROOT/.githooks/pre-commit-tests.sh"; then
        echo ""
        echo "❌ pre-commit tests FAALDEN — commit geblokkeerd."
        echo "   Skippen alleen met expliciete reden: git commit --no-verify -m 'no-verify: <reden>'"
        exit 1
    fi
fi

exit 0
